{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Jarvis Inference Runtime",
  "uid": "jarvis-inference",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests / min",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total[5m]))*60",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active requests",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "inference_active_requests",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "inference_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Circuit open",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(inference_circuit_open)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le,model) (rate(inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le,model) (rate(inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le,model) (rate(inference_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{model}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TTFT",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,model) (rate(inference_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Generation tokens/sec",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le,model) (rate(inference_tokens_per_second_bucket[5m])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue wait",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,model) (rate(inference_queue_wait_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host resources",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "inference_host_cpu_percent",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "inference_host_memory_available_gib",
          "legendFormat": "Host free GiB",
          "refId": "B"
        },
        {
          "expr": "inference_container_memory_available_gib",
          "legendFormat": "Gateway free GiB",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors / resource pressure",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(inference_requests_total{status!=\"success\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "expr": "rate(inference_resource_rejections_total[5m])",
          "legendFormat": "resource rejects",
          "refId": "B"
        },
        {
          "expr": "rate(inference_backend_errors_total[5m])",
          "legendFormat": "backend errors",
          "refId": "C"
        }
      ]
    }
  ]
}
