INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8080
# Set to 0.0.0.0 when AI Stack/Jarvis runs on another VM; keep 127.0.0.1 for local-only access.
INFERENCE_BIND_ADDRESS=127.0.0.1
INFERENCE_API_KEY=
# Only set true for isolated local development. Production startup fails closed without a key.
INFERENCE_ALLOW_INSECURE_NO_AUTH=false

MODEL_REGISTRY=qwen3:1.7b,qwen3:4b
DEFAULT_MODEL=qwen3:1.7b

# Dedicated inference VM: single CPU generation and single loaded model.
MAX_CONCURRENT_REQUESTS=1
# Waiting requests only; the active inference slot is separate.
MAX_QUEUE_SIZE=8
MAX_LOADED_MODELS=1

# Gateway admission budget; Ollama has its own container budget below.
MEMORY_BUDGET_GB=10
MEMORY_HEADROOM_GB=1.0

BACKEND_HTTP_TIMEOUT_SECONDS=600
# Separate deadlines keep queueing, embeddings, and generation from starving each other.
QUEUE_TIMEOUT_SECONDS=90
EMBEDDING_TIMEOUT_SECONDS=30
CHAT_TIMEOUT_SECONDS=300
STREAM_TIMEOUT_SECONDS=300
SHUTDOWN_TIMEOUT_SECONDS=30
MODEL_REFRESH_SECONDS=15

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=15

OLLAMA_URL=http://ollama:11434
LLAMACPP_URL=
OLLAMA_KEEP_ALIVE=30m

# Dedicated inference VM: 2 vCPU / 10 GiB total. Containers are capped at 1.9 CPU / 9 GiB to leave host headroom.
INFERENCE_CPUS=0.4
INFERENCE_MEMORY_LIMIT=1g
OLLAMA_CPUS=1.5
OLLAMA_MEMORY_LIMIT=8g
OLLAMA_MODELS=qwen3:1.7b,qwen3:4b,nomic-embed-text

# Watchdog thresholds.
MIN_FREE_DISK_GIB=10
MIN_AVAILABLE_RAM_GIB=1
