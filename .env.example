INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8080
INFERENCE_API_KEY=

MODEL_REGISTRY=qwen3:1.7b,qwen3:4b
DEFAULT_MODEL=qwen3:1.7b

# CPU-only OptiPlex 7040: one active generation at a time.
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUE_SIZE=8
MAX_LOADED_MODELS=1

# Admission protects the gateway container itself; Ollama is isolated in its own container.
MEMORY_BUDGET_GB=10
MEMORY_HEADROOM_GB=0.25

REQUEST_TIMEOUT_SECONDS=600
SHUTDOWN_TIMEOUT_SECONDS=30
MODEL_REFRESH_SECONDS=15

# Open circuit after repeated backend failures, then probe again after recovery.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=15

OLLAMA_URL=http://ollama:11434
LLAMACPP_URL=
OLLAMA_KEEP_ALIVE=30m

# Docker resource budget for the 16 GB host.
INFERENCE_CPUS=0.75
INFERENCE_MEMORY_LIMIT=1g
OLLAMA_CPUS=3.0
OLLAMA_MEMORY_LIMIT=10g
OLLAMA_MODELS=qwen3:1.7b,qwen3:4b
